{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/douglasmonsky/codex-usage-tracker/config/agent-kernel/question-catalog-v1.schema.json",
  "title": "Codex Usage Tracker agent-kernel question catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source",
    "guidance_budget_bytes",
    "parameter_ids",
    "capabilities",
    "measurements",
    "logical_primitives",
    "coverage_dimensions",
    "selector_kinds",
    "projection_ids",
    "evidence_classes",
    "performance_classes",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "codex-usage-tracker.question-catalog.v1"
    },
    "version": {
      "const": 1
    },
    "source": {
      "const": "docs/product/SUPPORTED_QUESTION_CONTRACTS.md"
    },
    "guidance_budget_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 16384
    },
    "parameter_ids": {
      "$ref": "#/$defs/nonEmptyIdentifierArray"
    },
    "capabilities": {
      "$ref": "#/$defs/nonEmptyIdentifierArray"
    },
    "measurements": {
      "$ref": "#/$defs/nonEmptyIdentifierArray"
    },
    "logical_primitives": {
      "$ref": "#/$defs/nonEmptyIdentifierArray"
    },
    "coverage_dimensions": {
      "$ref": "#/$defs/nonEmptyIdentifierArray"
    },
    "selector_kinds": {
      "$ref": "#/$defs/nonEmptyIdentifierArray"
    },
    "projection_ids": {
      "$ref": "#/$defs/identifierArray"
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/evidenceClass"
      }
    },
    "performance_classes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/performanceClass"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?::[a-z0-9_-]+)*$",
      "minLength": 1,
      "maxLength": 96
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "nonEmptyIdentifierArray": {
      "allOf": [
        {
          "$ref": "#/$defs/identifierArray"
        },
        {
          "minItems": 1
        }
      ]
    },
    "evidenceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selector_kinds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-7]$"
        },
        "selector_kinds": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        }
      }
    },
    "performanceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sql_p95_ms",
        "mcp_p95_ms",
        "query_calls",
        "evidence_calls",
        "response_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-5]$"
        },
        "sql_p95_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "mcp_p95_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "query_calls": {
          "const": 1
        },
        "evidence_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16384
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/identifierArray"
        },
        "optional": {
          "$ref": "#/$defs/identifierArray"
        }
      }
    },
    "logicalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitives",
        "operations",
        "compiler_id"
      ],
      "properties": {
        "primitives": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "aggregate",
              "comparison",
              "distribution",
              "feature_vector",
              "rows",
              "share",
              "status",
              "timeline"
            ]
          }
        },
        "compiler_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "formulas",
        "kernel_conclusion_fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "enum": [
              "exact",
              "deterministic",
              "configured_estimate",
              "model_inference",
              "unsupported"
            ]
          }
        },
        "formulas": {
          "$ref": "#/$defs/identifierArray"
        },
        "kernel_conclusion_fields": {
          "$ref": "#/$defs/identifierArray"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes",
        "selector_kinds"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E[0-7]$"
          }
        },
        "selector_kinds": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_rows",
        "maximum_rows",
        "exact_count_default"
      ],
      "properties": {
        "default_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maximum_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "exact_count_default": {
          "const": false
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "version",
        "title",
        "plan_id",
        "support_classes",
        "stage",
        "intent_phrases",
        "parameters",
        "required_capabilities",
        "required_measurements",
        "logical_plan",
        "answers",
        "coverage_requirements",
        "evidence",
        "prohibited_claims",
        "order",
        "limits",
        "performance_classes",
        "projection_consumers",
        "oracle_ids",
        "lower_model_hint"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^Q-[A-Z]{2,3}-[0-9]{2}$"
        },
        "version": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "plan_id": {
          "$ref": "#/$defs/identifier"
        },
        "support_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "N",
              "C",
              "I",
              "O",
              "D",
              "U"
            ]
          }
        },
        "stage": {
          "enum": [
            "Foundation",
            "Cutover",
            "Advanced",
            "Inference",
            "Optional",
            "Deferred"
          ]
        },
        "intent_phrases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          }
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "required_capabilities": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "required_measurements": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "logical_plan": {
          "$ref": "#/$defs/logicalPlan"
        },
        "answers": {
          "$ref": "#/$defs/answers"
        },
        "coverage_requirements": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "prohibited_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          }
        },
        "order": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "performance_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^P[0-5]$"
          }
        },
        "projection_consumers": {
          "$ref": "#/$defs/identifierArray"
        },
        "oracle_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^oracle:q-[a-z]+-[0-9]{2}:[a-z0-9_-]+$",
            "maxLength": 96
          }
        },
        "lower_model_hint": {
          "type": "string",
          "minLength": 12,
          "maxLength": 320
        }
      }
    }
  }
}
