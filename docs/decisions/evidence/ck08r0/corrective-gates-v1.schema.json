        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "tests/agent_kernel/fixtures/tiny-v2/question-scenarios.json"}, "sha256": {"const": "f26fce4ba5bc75e2efb0e7bab698e2029af4152536dfc87a9c4329c749a347eb"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "tests/agent_kernel/fixtures/profiles/standard-v1.json"}, "sha256": {"const": "ef0da880255a0b13ea6055e0f8d748870c075635aa6f199c9521462c681250f3"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "tests/agent_kernel/fixtures/profiles/production-v1.json"}, "sha256": {"const": "2de0b4dc198603da6c1b0905b8d934e2cd5604e4036ef009d0cd07f1cc81f51b"}}}]},
