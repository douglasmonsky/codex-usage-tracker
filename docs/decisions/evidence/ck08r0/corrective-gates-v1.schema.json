        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "config/agent-kernel/question-catalog-v1.json"}, "sha256": {"const": "728645673260efbd59c025cbc0c0ff30353bb712a98676c500e08d9f49fde497"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "config/agent-kernel/formula-contract-v1.json"}, "sha256": {"const": "2e16599f244ac179313aa7bf7263caaddbd49f2c0984dbfa424ba89713e70ffa"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "config/agent-kernel/plan-operand-contract-v1.json"}, "sha256": {"const": "19b9c69f50f67b01321e1f269cee2f70370ca64c0c666ff4dac2cc52efa314b4"}}}]},
