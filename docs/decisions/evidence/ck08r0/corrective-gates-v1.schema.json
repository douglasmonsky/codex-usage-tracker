        "service_p95_ms": {
          "$ref": "#/$defs/classBudget"
        },
        "response_bytes_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "properties": {
        "P0": {
          "type": "integer",
          "minimum": 1
        },
        "P1": {
          "type": "integer",
          "minimum": 1
        },
        "P2": {
          "type": "integer",
          "minimum": 1
        },
        "P3": {
          "type": "integer",
          "minimum": 1
        },
        "P4": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidenceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_rows",
