    "releaseRatchets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wheel_bytes",
        "sdist_bytes",
        "maximum_headroom_percent",
        "catalog_count_headroom"
      ],
      "properties": {
        "wheel_bytes": {
          "const": 383000
        },
        "sdist_bytes": {
          "const": 820000
        },
        "maximum_headroom_percent": {
          "const": 25
        },
        "catalog_count_headroom": {
          "const": 0
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtures",
        "sample_count",
        "plan_budgets",
        "evidence",
        "lifecycle",
        "release_size_ratchets"
      ],
      "properties": {
        "fixtures": {
          "$ref": "#/$defs/fixtures"
        },
        "sample_count": {
          "const": 5
        },
        "plan_budgets": {
          "$ref": "#/$defs/planBudgets"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceBudgets"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycleBudgets"
        },
        "release_size_ratchets": {
          "$ref": "#/$defs/releaseRatchets"
        }
      }
    },
    "historicalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_packets",
        "rewrite_historical_artifacts",
        "amend_by_linked_requalification"
      ],
      "properties": {
        "preserve_packets": {
          "const": [
            "CK-03",
            "CK-04",
            "CK-05",
            "CK-06",
            "CK-07",
            "CK-07A",
            "CK-08"
          ]
        },
        "rewrite_historical_artifacts": {
          "const": false
        },
        "amend_by_linked_requalification": {
          "const": true
        }
      }
