        "semantic_mismatch": {
          "type": "string",
          "minLength": 1
        },
        "physical_gap": {
          "type": "string",
          "minLength": 1
        },
        "scale_breach": {
          "type": "string",
          "minLength": 1
        },
        "maintainability_instability": {
          "type": "string",
          "minLength": 1
