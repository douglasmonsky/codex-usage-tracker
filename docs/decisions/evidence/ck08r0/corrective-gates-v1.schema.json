      ],
      "properties": {
        "lane": {
          "type": "string",
          "pattern": "^CK-(07R1|08R[1-4G]|QG1)$"
        },
        "requalifies": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "failureRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ck09_remains_blocked",
