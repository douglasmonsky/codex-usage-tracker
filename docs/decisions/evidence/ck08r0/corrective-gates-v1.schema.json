        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "src/codex_usage_tracker/agent_kernel/query/service.py"}, "sha256": {"const": "0dc6ea87e82648128e9271ff92f40664d284d635aff04e540c6e6ed624d378d8"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "src/codex_usage_tracker/agent_kernel/evidence/service.py"}, "sha256": {"const": "ea32223d1afd997f310419bff0b6b260193e527c8333c9f561bcab280447dfa3"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "src/codex_usage_tracker/agent_kernel/publication/preparation.py"}, "sha256": {"const": "408d18e44c87da234d220c29298ebac1780e9426e2dce767b0bfc3ae65e8a872"}}}]}
      ]
