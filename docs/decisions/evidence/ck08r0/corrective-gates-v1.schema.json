          "enum": [
            "ef0da880255a0b13ea6055e0f8d748870c075635aa6f199c9521462c681250f3",
            "2de0b4dc198603da6c1b0905b8d934e2cd5604e4036ef009d0cd07f1cc81f51b"
          ]
        },
        "model_calls": {
          "enum": [100000, 1316864]
        },
        "seed": {
          "const": 20260728
        },
        "history_days": {
          "const": 1095
        },
        "semantic_cases": {
          "const": [
            "context_deterioration",
            "workflow_sequence_first_mutation",
            "allowance_interval_accounting",
            "parent_subagent_aggregation",
            "evidence_source_lifecycle"
          ]
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "production",
        "synthetic_only",
        "same_semantic_case_library",
        "publication_receipt_required"
      ],
      "properties": {
        "standard": {
          "allOf": [
            {"$ref": "#/$defs/fixture"},
            {
              "properties": {
                "path": {"const": "tests/agent_kernel/fixtures/profiles/standard-v1.json"},
                "sha256": {"const": "ef0da880255a0b13ea6055e0f8d748870c075635aa6f199c9521462c681250f3"},
                "model_calls": {"const": 100000}
              }
            }
          ]
        },
        "production": {
          "allOf": [
            {"$ref": "#/$defs/fixture"},
            {
              "properties": {
                "path": {"const": "tests/agent_kernel/fixtures/profiles/production-v1.json"},
                "sha256": {"const": "2de0b4dc198603da6c1b0905b8d934e2cd5604e4036ef009d0cd07f1cc81f51b"},
                "model_calls": {"const": 1316864}
              }
            }
          ]
        },
        "synthetic_only": {
          "const": true
        },
        "same_semantic_case_library": {
          "const": true
        },
        "publication_receipt_required": {
          "const": true
        }
      }
    },
    "planBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "sql_p95_ms",
        "service_p95_ms",
