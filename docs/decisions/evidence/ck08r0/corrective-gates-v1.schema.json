      "properties": {
        "maximum_rows": {
          "const": 100
        },
        "maximum_bytes": {
          "const": 16384
        },
        "first_and_deep_pages_required": {
          "const": true
        },
        "exact_count_forbidden": {
          "const": true
        }
      }
    },
    "lifecycleBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thirty_day_first_publication_p95_ms",
        "production_all_time_p95_ms",
        "no_change_p95_ms",
        "one_call_tail_p95_ms",
        "one_tool_tail_p95_ms"
      ],
      "properties": {
        "thirty_day_first_publication_p95_ms": {
          "const": 5000
        },
        "production_all_time_p95_ms": {
          "const": 120000
