  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "claim"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "activationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "ready_before_gate"],
      "properties": {
        "condition": {"const": "CK-08R0 merged and exact-main verified"},
        "ready_before_gate": {"const": false}
      }
    },
    "evidenceSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256",
        "definition"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^codex-usage-tracker\\.[a-z0-9.-]+\\.v[0-9]+$"
        },
        "path": {
          "const": "docs/decisions/evidence/ck08r0/corrective-lane-evidence-v1.schema.json"
        },
        "sha256": {
          "const": "a5e1013005ee85ab78c88a6a97bbaf7c13114c0f56e065b32fc7d4240911e4b2"
        },
        "definition": {
          "enum": [
            "#/$defs/answerTruth",
            "#/$defs/pageExecutor",
            "#/$defs/evidenceScale",
            "#/$defs/lifecycleScale",
            "#/$defs/maintainability",
            "#/$defs/physicalReclassification",
            "#/$defs/resumeGate"
          ]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owned_lock",
        "producer_artifact",
        "independent_truth",
        "consumer_seam",
        "evidence_schema",
        "fail_closed"
      ],
      "properties": {
        "id": {
          "enum": [
            "CK-08R1",
            "CK-08R2",
            "CK-08R3",
            "CK-07R1",
            "CK-QG1",
            "CK-08R4",
            "CK-08RG"
          ]
        },
        "owned_lock": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "producer_artifact": {
          "type": "string",
          "minLength": 1
        },
        "independent_truth": {
          "type": "string",
          "minLength": 1
        },
        "consumer_seam": {
          "type": "string",
          "minLength": 1
        },
        "evidence_schema": {
          "$ref": "#/$defs/evidenceSchema"
        },
        "fail_closed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answerTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "variant_count",
        "scenario_artifact",
        "reference_interface",
        "permitted_shared_authority",
        "production_imports_forbidden",
        "sqlite_forbidden",
        "computed_answer_sharing_forbidden",
        "exact_comparison",
        "mutation_checks"
      ],
      "properties": {
        "schema": {
          "const": "codex-usage-tracker.answer-truth-requalification.v1"
        },
        "variant_count": {
          "const": 80
        },
        "scenario_artifact": {
          "$ref": "#/$defs/artifact"
        },
        "reference_interface": {
          "type": "string",
          "minLength": 1
        },
        "permitted_shared_authority": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "production_imports_forbidden": {
          "const": true
        },
        "sqlite_forbidden": {
          "const": true
        },
        "computed_answer_sharing_forbidden": {
          "const": true
        },
        "exact_comparison": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "request",
              "rows",
              "grades",
              "total_order",
              "ordered_evidence"
            ]
          }
        },
        "mutation_checks": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "pageExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_fields",
        "result_fields",
        "cursor_binding",
        "sql_before_python",
        "complete_materialization_forbidden",
        "production_evaluate_plan_forbidden",
        "maximum_page_rows",
        "exact_count_default",
        "stage_measurements",
        "classifications",
        "classification_owner"
      ],
      "properties": {
        "schema": {
          "const": "codex-usage-tracker.page-executor-benchmark.v2"
        },
        "request_fields": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "result_fields": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "cursor_binding": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "sql_before_python": {
          "type": "array",
          "prefixItems": [
            {
              "const": "complete total order"
            },
            {
              "const": "publication-bound keyset predicate"
            },
            {
              "const": "LIMIT page_size + 1"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "complete_materialization_forbidden": {
          "const": true
        },
        "production_evaluate_plan_forbidden": {
          "const": true
        },
        "maximum_page_rows": {
          "const": 100
        },
        "exact_count_default": {
          "const": false
        },
        "stage_measurements": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "classifications": {
          "const": [
            "direct_page",
            "evidence_page",
            "projection_required"
          ]
        },
        "classification_owner": {
          "const": "CK-08R4"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "model_calls",
        "seed",
        "history_days",
        "semantic_cases"
