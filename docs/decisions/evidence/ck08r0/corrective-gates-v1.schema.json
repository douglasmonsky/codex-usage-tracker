      "$ref": "#/$defs/answerTruth"
    },
    "page_executor": {
      "$ref": "#/$defs/pageExecutor"
    },
    "scale": {
      "$ref": "#/$defs/scale"
    },
    "historical_evidence_policy": {
      "$ref": "#/$defs/historicalPolicy"
    },
    "superseded_claims": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "preserved_claims": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "requalification_frontier": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/requalification"}, {"properties": {"lane": {"const": "CK-08R1"}}}]},
        {"allOf": [{"$ref": "#/$defs/requalification"}, {"properties": {"lane": {"const": "CK-08R2"}}}]},
        {"allOf": [{"$ref": "#/$defs/requalification"}, {"properties": {"lane": {"const": "CK-08R3"}}}]},
        {"allOf": [{"$ref": "#/$defs/requalification"}, {"properties": {"lane": {"const": "CK-07R1"}}}]},
        {"allOf": [{"$ref": "#/$defs/requalification"}, {"properties": {"lane": {"const": "CK-QG1"}}}]},
        {"allOf": [{"$ref": "#/$defs/requalification"}, {"properties": {"lane": {"const": "CK-08R4"}}}]},
