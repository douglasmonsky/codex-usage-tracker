    "successor_activation_gate": {
      "$ref": "#/$defs/activationGate"
    },
    "ready_successors": {
      "const": [
        "CK-08R1",
        "CK-08R2",
        "CK-08R3",
        "CK-07R1",
        "CK-QG1"
      ]
    },
    "lanes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"id": {"const": "CK-08R1"}}}]},
        {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"id": {"const": "CK-08R2"}}}]},
        {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"id": {"const": "CK-08R3"}}}]},
        {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"id": {"const": "CK-07R1"}}}]},
        {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"id": {"const": "CK-QG1"}}}]},
        {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"id": {"const": "CK-08R4"}}}]},
        {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"id": {"const": "CK-08RG"}}}]}
      ]
