  "branch_ownership_proof": {
    "method": "EXPLAIN QUERY PLAN four-column id-parent-notused-detail topology",
    "session_event_input_route": "unique leftmost-child ancestry from the compound-query root",
    "unique_structural_candidate": true,
    "candidate_parent_count": 1,
    "session_branch_cardinality": "at_most_one",
    "direct_sibling_chain": [
      "SEARCH s USING PRIMARY KEY (session_id=?)",
      "SEARCH o USING PRIMARY KEY (occurrence_id=?) LEFT-JOIN",
      "SEARCH sm USING INDEX source_manifestations_by_occurrence_key (manifestation_key=?) LEFT-JOIN"
    ],
    "direct_sibling_order": "session_pk_then_optional_bound_head_then_occurrence_pk_then_unique_manifestation_then_marker",
    "optional_bound_head_nodes": [
      "SCALAR SUBQUERY <decimal> with exactly one descendant SEARCH bound_head USING PRIMARY KEY (singleton=?)",
      "SEARCH bound_head EXISTS USING PRIMARY KEY (singleton=?)"
    ],
    "marker": "USE TEMP B-TREE FOR ORDER BY",
    "marker_parent_must_equal_session_branch_parent": true,
    "marker_must_follow_manifestation_lookup": true,
    "marker_maximum": 1,
    "all_other_direct_branch_details_reject": true,
    "non_session_branch_rejection": [
      "model-call source lookup",
      "model-call-tail source lookup",
      "tool source lookup",
      "state-change source lookup",
      "activity source lookup",
      "compaction source lookup",
      "context-component source lookup",
      "lifecycle source lookup"
    ]
  },
